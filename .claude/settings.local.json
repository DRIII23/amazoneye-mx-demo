{
  "permissions": {
    "allow": [
      "Bash(node --input-type=module -e ' *)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:5173/)",
      "Bash(curl -s -o /dev/null -w \"main.js: %{http_code}\\\\n\" http://localhost:5173/src/main.js)",
      "Bash(curl -s -o /dev/null -w \"map.js: %{http_code}\\\\n\" http://localhost:5173/src/map/map.js)",
      "Bash(curl -s -o /dev/null -w \"style.css: %{http_code}\\\\n\" http://localhost:5173/src/style.css)",
      "Bash(git --version)",
      "Bash(gh --version)",
      "Bash(gh auth *)",
      "Bash(git config *)",
      "Bash(echo \"name: $\\(git config user.name\\)\")",
      "Bash(echo \"email: $\\(git config user.email\\)\")",
      "Bash(git init *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ]
  }
}
